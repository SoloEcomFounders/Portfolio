<h1>Reset password</h1>
{%- form 'reset_customer_password', class: 'form' -%}
  {{ form.errors | default_errors }}
  <label for="ResetPassword">New password</label><input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password">
  <label for="ResetConfirm">Confirm password</label><input type="password" name="customer[password_confirmation]" id="ResetConfirm" autocomplete="new-password">
  <button class="btn" type="submit">Reset password</button>
{%- endform -%}
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
