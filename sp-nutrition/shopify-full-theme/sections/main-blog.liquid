<h1>{{ blog.title }}</h1>
{%- paginate blog.articles by 12 -%}
  <div class="grid">
    {%- for article in blog.articles -%}
      <a class="card" href="{{ article.url }}">
        <div class="media">{%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}{%- endif -%}</div>
        <div class="info"><span>{{ article.title }}</span><span class="muted">{{ article.published_at | date: '%B %d, %Y' }}</span></div>
      </a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
