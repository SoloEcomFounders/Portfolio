<div class="hero">
  <h1>{{ section.settings.heading }}</h1>
  <p class="muted">{{ section.settings.text }}</p>
  <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
</div>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deeper sleep. Calmer mornings." },
    { "type": "text", "id": "text", "label": "Text", "default": "400mg pure magnesium bisglycinate in two raspberry gummies." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
