<header class="site-header">
  <div class="bar">
    <a class="logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
    <nav aria-label="Main">
      {%- for link in linklists['main-menu'].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <a href="{{ routes.cart_url }}">🛒 Cart ({{ cart.item_count }})</a>
    </nav>
  </div>
</header>
{% schema %}
{ "name": "Header", "settings": [] }
{% endschema %}
