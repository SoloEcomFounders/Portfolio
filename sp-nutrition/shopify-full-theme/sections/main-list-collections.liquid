<h1>Collections</h1>
<div class="grid">
  {%- for collection in collections -%}
    <a class="card" href="{{ collection.url }}">
      <div class="media">{%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}{%- endif -%}</div>
      <div class="info"><span>{{ collection.title }}</span></div>
    </a>
  {%- endfor -%}
</div>
{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
