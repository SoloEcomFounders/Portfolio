<h1>Create account</h1>
{%- form 'create_customer', class: 'form' -%}
  {{ form.errors | default_errors }}
  <label for="FirstName">First name</label><input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
  <label for="LastName">Last name</label><input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
  <label for="RegEmail">Email</label><input type="email" name="customer[email]" id="RegEmail" autocomplete="email">
  <label for="RegPassword">Password</label><input type="password" name="customer[password]" id="RegPassword" autocomplete="new-password">
  <button class="btn" type="submit">Create</button>
{%- endform -%}
{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
