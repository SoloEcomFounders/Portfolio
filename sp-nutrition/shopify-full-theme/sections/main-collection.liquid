<h1>{{ collection.title }}</h1>
{%- if collection.description != blank -%}<div class="rte muted">{{ collection.description }}</div>{%- endif -%}
{%- paginate collection.products by 24 -%}
  <div class="grid" style="margin-top:20px">
    {%- for product in collection.products -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      <p class="muted">No products in this collection yet.</p>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
{%- endpaginate -%}
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
