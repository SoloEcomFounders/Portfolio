{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Your gift card | {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-width main">
      <div class="hero">
        <h1>{{ shop.name }} gift card</h1>
        <p style="font-size:32px;font-weight:800">{{ gift_card.balance | money }}</p>
        {%- if gift_card.expired or gift_card.enabled == false -%}<p class="muted">This gift card is no longer active.</p>{%- endif -%}
        <p>Code: <strong>{{ gift_card.code | format_code }}</strong></p>
        <a class="btn" href="{{ shop.url }}">Start shopping</a>
      </div>
    </main>
  </body>
</html>
